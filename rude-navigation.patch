+package app.organicmaps.sdk.sound;
+
+import android.location.Location;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import app.organicmaps.sdk.routing.RoutingInfo;
+import app.organicmaps.sdk.util.Config;
+
+public final class RudeDrivingMonitor
+{
+  private static final long SPEEDING_COOLDOWN_MS = 30_000L;
+  private static final long BRAKING_COOLDOWN_MS = 20_000L;
+  private static final long CORNER_COOLDOWN_MS = 30_000L;
+  private static final long SPEEDING_DELAY_MS = 5_000L;
+  private static final float HARSH_BRAKING_MPS2 = -4.0f;
+  private static final float FAST_CORNER_MPS = 13.9f;
+  private static final float FAST_CORNER_BEARING_DEG = 35.0f;
+
+  @Nullable private Location mPreviousLocation;
+  private long mSpeedingSince = 0L;
+  private long mLastSpeedingComment = 0L;
+  private long mLastBrakingComment = 0L;
+  private long mLastCornerComment = 0L;
+
+  public void onLocationUpdated(@NonNull Location location, @Nullable RoutingInfo routingInfo)
+  {
+    if (!Config.TTS.isRudeEnabled() || !Config.TTS.isEnabled())
+    {
+      mPreviousLocation = new Location(location);
+      return;
+    }
+
+    final long now = location.getTime();
+    final float speed = location.hasSpeed() ? location.getSpeed() : -1.0f;
+    final float speedLimit =
+        routingInfo == null ? -1.0f : (float) routingInfo.speedLimitMps;
+
+    if (speed >= 0.0f && speedLimit > 0.0f
+        && speed > speedLimit + Math.max(1.0f, speedLimit * 0.10f))
+    {
+      if (mSpeedingSince == 0L)
+        mSpeedingSince = now;
+
+      if (now - mSpeedingSince >= SPEEDING_DELAY_MS
+          && now - mLastSpeedingComment >= SPEEDING_COOLDOWN_MS)
+      {
+        speak(RudeTts.speedingComment());
+        mLastSpeedingComment = now;
+      }
+    }
+    else
+    {
+      mSpeedingSince = 0L;
+    }
+
+    if (mPreviousLocation != null)
+    {
+      final long dtMs = Math.max(1L, now - mPreviousLocation.getTime());
+      final float acceleration =
+          speed >= 0.0f && mPreviousLocation.hasSpeed()
+              ? (speed - mPreviousLocation.getSpeed()) / (dtMs / 1000.0f)
+              : 0.0f;
+
+      if (acceleration <= HARSH_BRAKING_MPS2
+          && now - mLastBrakingComment >= BRAKING_COOLDOWN_MS)
+      {
+        speak(RudeTts.harshBrakingComment());
+        mLastBrakingComment = now;
+      }
+
+      if (speed >= FAST_CORNER_MPS
+          && mPreviousLocation.hasBearing()
+          && location.hasBearing())
+      {
+        float delta = Math.abs(location.getBearing() - mPreviousLocation.getBearing());
+        if (delta > 180.0f)
+          delta = 360.0f - delta;
+
+        if (delta >= FAST_CORNER_BEARING_DEG
+            && now - mLastCornerComment >= CORNER_COOLDOWN_MS)
+        {
+          speak(RudeTts.fastCornerComment());
+          mLastCornerComment = now;
+        }
+      }
+    }
+
+    mPreviousLocation = new Location(location);
+  }
+
+  public void reset()
+  {
+    mPreviousLocation = null;
+    mSpeedingSince = 0L;
+    mLastSpeedingComment = 0L;
+    mLastBrakingComment = 0L;
+    mLastCornerComment = 0L;
+  }
+
+  private static void speak(@NonNull String text)
+  {
+    TtsPlayer.INSTANCE.playTurnNotifications(new String[] {text});
+  }
+}
